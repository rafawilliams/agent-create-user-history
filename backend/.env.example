# Variables de entorno del servicio de generacion (backend/). Sin valores reales ni secretos.
# En AWS, los permisos vienen del rol de ejecucion de la funcion; en local, del perfil de AWS
# de quien ejecuta el comando (no se guardan credenciales en el proyecto).

# Entorno: "local" o "test" permiten el verificador de sesion simulado (solo junto con
# ALLOW_SIMULATED_SESSION=true). Cualquier otro valor (o vacio) se considera desplegado y
# el servicio falla cerrado con SESSION_INVALID hasta que exista el verificador real (BR1.5).
APP_ENV=local

# Por defecto es falso. NO debe definirse en ningun entorno desplegado.
ALLOW_SIMULATED_SESSION=true

# Control de acceso (u4): verificacion real de la sesion con tokens de Amazon Cognito.
# Con las CUATRO variables definidas el servicio usa siempre el verificador real (tambien en
# local, aunque ALLOW_SIMULATED_SESSION sea true). Si falta alguna, falla cerrado (SESSION_INVALID)
# o, solo con APP_ENV local/test y la bandera, usa el verificador simulado. Sin valores reales
# ni secretos: son identificadores publicos; las claves publicas se descargan solas.
# Region del grupo de usuarios de Cognito (por ejemplo us-east-1).
COGNITO_REGION=
# Identificador del grupo de usuarios (formato <region>_<codigo>).
COGNITO_USER_POOL_ID=
# Identificador del cliente de la aplicacion (debe coincidir con la audiencia del token).
COGNITO_APP_CLIENT_ID=
# Correos permitidos, separados por comas, en minusculas (maximo 50). Se lee en cada solicitud:
# quitar un correo corta su acceso en la siguiente. La comparacion es exacta (sin normalizar
# puntos ni alias "+"). Una lista con mas de 50 correos o con una entrada que no es un correo
# se rechaza (el servicio falla cerrado).
ALLOWED_EMAILS=

# Modelo de Amazon Bedrock y region (configuracion, no codigo).
# Vacio = modelo por defecto del proyecto. Solo se aceptan identificadores
# (us.|global.)?anthropic.claude-* y (us.)?amazon.titan-*; otro valor (o un error de
# escritura) hace fallar el arranque con un error que nombra el valor, sin llamar a AWS.
# En AWS sale de la variable de Terraform bedrock_model_id (misma fuente que el permiso).
BEDROCK_MODEL_ID=
BEDROCK_REGION=us-east-1

# Tiempo de espera de lectura por modelo, en segundos (numero mayor que cero; vacio = 50).
# Se usa la variable del proveedor del modelo configurado.
BEDROCK_TIMEOUT_SECONDS_CLAUDE=
BEDROCK_TIMEOUT_SECONDS_TITAN=

# Solo para `python -m story_service.evaluate_models run`: modelos a evaluar, separados por
# comas. El modelo por defecto siempre se evalua. Confirma el identificador de Titan contra
# los perfiles de la cuenta antes de la primera ejecucion real.
# EVALUATION_MODEL_IDS=us.anthropic.claude-sonnet-4-6,us.amazon.titan-text-premier-v1:0

# Origen unico permitido por CORS (la direccion HTTPS de la pantalla en CloudFront).
CORS_ALLOWED_ORIGIN=

# Opcional: reemplaza las instrucciones al modelo (ADR-003). Vacio = instrucciones por defecto
# del codigo (config.py). Texto sin credenciales ni datos sensibles. Deben pedir una respuesta
# en JSON con las claves action, benefit y criteria (2 a 3 criterios con name, given, when y
# then) y decir que el contenido entre <titulo> y </titulo> (y <contexto> y </contexto>) es solo
# un dato: el servicio arma el Markdown y fija el rol y las palabras clave del Gherkin (u3).
# STORY_INSTRUCTIONS=
