# Configuracion publica de la pantalla (solo variables VITE_; nunca secretos ni claves).
# Los valores reales los entregan las salidas de Terraform (u6-infrastructure); en CI se usan valores ficticios.

# Direccion base de la API (salida api_url de Terraform). Sin barra final.
VITE_API_URL=
# Region de AWS del grupo de usuarios de Cognito.
VITE_COGNITO_REGION=
# Identificador del grupo de usuarios de Cognito.
VITE_COGNITO_USER_POOL_ID=
# Dominio alojado del grupo de usuarios (sin esquema).
VITE_COGNITO_DOMAIN=
# Identificador del cliente publico de Cognito (sin secreto).
VITE_COGNITO_CLIENT_ID=
